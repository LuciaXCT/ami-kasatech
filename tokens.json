{
  "$schema": "https://json.schemastore.org/design-tokens",
  "name": "AMI-KasaTECH-Tokens",
  "version": "1.0.0",
  "color": {
    "paper": {
      "value": "#FFF7F4",
      "type": "color",
      "description": "Primary canvas and packaging paper wrap background"
    },
    "cream": {
      "value": "#FFFDF9",
      "type": "color",
      "description": "Unibody shell, cards, insert trays, and eye capsule fill"
    },
    "rose": {
      "value": "#D88E9A",
      "type": "color",
      "description": "Primary accent, action controls, eye aura, and breathing heart ring"
    },
    "rose-deep": {
      "value": "#965765",
      "type": "color",
      "description": "High-contrast accent text, hot-stamped box foil, and borders on light tints"
    },
    "rose-soft": {
      "value": "#F6E4E3",
      "type": "color",
      "description": "Subtle tinted surfaces and selected segment backgrounds"
    },
    "peach": {
      "value": "#F6D9CA",
      "type": "color",
      "description": "Warm secondary accents and tactile card inserts"
    },
    "ink": {
      "value": "#3E3334",
      "type": "color",
      "description": "Primary text and deep neutral visor shadow core"
    },
    "muted": {
      "value": "#837273",
      "type": "color",
      "description": "Secondary typography, interval counters, and metadata"
    },
    "line": {
      "value": "#EED8D8",
      "type": "color",
      "description": "Single-pixel structural dividing rules and panel perimeters"
    },
    "sage": {
      "value": "#7A9280",
      "type": "color",
      "description": "Completed session state indicator and physical package seal label"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "value": "Plus Jakarta Sans, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "type": "fontFamily"
      },
      "mono": {
        "value": "JetBrains Mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
        "type": "fontFamily"
      }
    },
    "fontSize": {
      "display-hero": { "value": "56px", "lineHeight": "1.1", "letterSpacing": "-0.02em" },
      "display-title": { "value": "40px", "lineHeight": "1.15", "letterSpacing": "-0.015em" },
      "section-heading": { "value": "28px", "lineHeight": "1.25", "letterSpacing": "-0.01em" },
      "card-heading": { "value": "20px", "lineHeight": "1.35", "letterSpacing": "0" },
      "body": { "value": "16px", "lineHeight": "1.6", "letterSpacing": "0" },
      "label": { "value": "12px", "lineHeight": "1.4", "letterSpacing": "0.08em", "textTransform": "uppercase" },
      "timer-display": { "value": "96px", "lineHeight": "1.0", "letterSpacing": "-0.03em" },
      "stat-number": { "value": "44px", "lineHeight": "1.1", "letterSpacing": "-0.02em" }
    }
  },
  "geometry": {
    "product": {
      "height": "150mm",
      "width": "110mm",
      "depth": "100mm",
      "form": "Continuous vertical ovoid, widest across shoulders, resting on hidden silicone base ring",
      "shadowGap": "3mm",
      "visorHeightRatio": "0.60",
      "rearButtonDiameter": "8mm",
      "baseHeartRingWidth": "2mm",
      "speakerArcDegrees": "60deg",
      "speakerApertureDiameter": "0.4mm"
    },
    "radii": {
      "card": "22px",
      "control": "13px",
      "pill": "99px",
      "visor-corner": "48px"
    },
    "elevation": {
      "grounded": "0 14px 42px rgba(92, 57, 60, 0.08)",
      "inset-rule": "0 1px 0 #EED8D8"
    }
  },
  "motion": {
    "duration": {
      "quick": "180ms",
      "standard": "260ms",
      "breathe": "4000ms"
    },
    "easing": {
      "default": "cubic-bezier(0.16, 1, 0.3, 1)",
      "breathe": "cubic-bezier(0.45, 0.05, 0.55, 0.95)"
    }
  }
}
